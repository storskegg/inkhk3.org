{
  "name": "inkhk3.org",
  "version": "1.0.0",
  "description": "Source for inkhk3.org website.",
  "main": "src/index.html",
  "bin": {
    "serve": "bin/serve.mjs",
    "serve-dist": "bin/serve-dist.mjs"
  },
  "engines": {
    "npm": ">=11.6.2 <12.0.0",
    "node": ">=24.12.0 <25.0.0"
  },
  "scripts": {
    "build:vite": "npx vite build",
    "serve": "vite",
    "serve-dist": "npm run build && vite preview",
    "dev": "npm run serve",
