{
  "name": "inkhk3.org",
  "version": "2026.46.2",
  "description": "Source for inkhk3.org website.",
  "main": "src/index.html",
  "bin": {
    "serve": "bin/serve.mjs",
    "serve-dist": "bin/serve-dist.mjs"
  },
  "engines": {
    "npm": ">=11.20.0 <12.0.0",
    "node": ">=26.13.0 <27.0.0"
  },
  "scripts": {
    "build:vite": "npx vite build",
    "serve": "vite --config vite.lab.config.ts",
    "serve-dist": "npm run build && vite preview",
    "dev": "vite",
    "start": "vite",
    "lab": "npm run serve",
    "prebuild": "node bin/check-arch.mjs",
    "build": "npm run build:vite",
    "postbuild": "postcss dist/*.css -u autoprefixer cssnano -r --no-map && node bin/sri.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storskegg/inkhk3.org.git"
  },
  "author": "Liam Conrad",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/storskegg/inkhk3.org/issues"
  },
  "homepage": "https://inkhk3.org",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "browser-sync": "^3.0.4",
    "copyfiles": "^2.4.1",
    "cssnano": "^9.9.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss-cli": "^12.0.0",
    "sass": "^1.108.1",
    "vite": "^8.3.7",
    "vite-plugin-clean": "^2.0.1"
  }
}
